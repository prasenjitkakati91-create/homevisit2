rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isPhysio(physioId) {
      return (isSignedIn() && request.auth.uid == physioId) || physioId == 'default_physio' || physioId == null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128; // removed brittle regex
    }

    // Patients
    match /patients/{patientId} {
      allow get: if true;
      allow list: if true; // In a real app we would restrict this by physioId
      
      function isValidPatient(data) {
        return data.name is string && data.name.size() > 0 
            && data.physioId is string && isValidId(data.physioId);
      }

      allow create: if isPhysio(request.resource.data.physioId) && isValidPatient(request.resource.data);
      allow update: if isPhysio(resource.data.physioId) && isValidPatient(request.resource.data);
      allow delete: if isPhysio(resource.data.physioId);

      // Cases
      match /cases/{caseId} {
        allow read, list: if true;
        
        function isValidCase(data) {
          return data.diagnosis is string && data.physioId is string && isValidId(data.physioId);
        }

        allow create: if isPhysio(request.resource.data.physioId) && isValidCase(request.resource.data);
        allow update: if isPhysio(resource.data.physioId) && isValidCase(request.resource.data);
        allow delete: if isPhysio(resource.data.physioId);

        // Sessions
        match /sessions/{sessionId} {
          allow read, list: if true;
          
          function isValidSession(data) {
            return data.physioId is string && isValidId(data.physioId);
          }

          allow create: if isPhysio(request.resource.data.physioId) && isValidSession(request.resource.data);
          allow update: if isPhysio(resource.data.physioId) && isValidSession(request.resource.data);
          allow delete: if isPhysio(resource.data.physioId);
        }
      }

      // Files
      match /files/{fileId} {
        allow read, list: if true;
        allow create: if isPhysio(request.resource.data.physioId);
        allow update: if isPhysio(resource.data.physioId) && isPhysio(request.resource.data.physioId);
        allow delete: if isPhysio(resource.data.physioId);
      }
    }

    // Collection Group Access
    match /{path=**}/cases/{caseId} {
      allow read, list: if true;
      allow delete: if isPhysio(resource.data.physioId);
    }
    
    match /{path=**}/sessions/{sessionId} {
      allow read, list: if true;
      allow delete: if isPhysio(resource.data.physioId);
    }
    
    match /{path=**}/files/{fileId} {
      allow read, list: if true;
      allow delete: if isPhysio(resource.data.physioId);
    }
  }
}
